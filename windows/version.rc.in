// The details Explorer shows for Deepwater.exe (Properties › Details, and the description in Task Manager): made by
// CMake from this file with the project's version (CMakeLists.txt, configure_file).
#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "FileDescription", "Deepwater Mark 4 — terminal de marché"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "Deepwater"
      VALUE "OriginalFilename", "Deepwater.exe"
      VALUE "ProductName", "Deepwater Mark 4"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "Licence GNU AGPL 3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
